<?xml version="1.0" encoding="UTF-8"?>
<manifest>
	<remote name="gh" fetch="https://github.com" />
	<remote name="gitlb" fetch="https://gitlab.com" />
	<remote name="gh-kanup4m" fetch="https://github.com/kanup4m" />

    <!-- device tree (RisingOS 16 QPR2, Beyonder) -->
    <project name="android_device_xiaomi_chenfeng"
					 remote="gh-kanup4m"
					 revision="rising-16-qpr2"
					 path="device/xiaomi/chenfeng" />

	<!-- miuicamera tree -->
    <project name="xiaomi-chenfeng/android_device_xiaomi_chenfeng-miuicamera"
					 remote="gitlb"
					 revision="lineage-23.2"
					 path="device/xiaomi/chenfeng-miuicamera" />

    <!-- kernel tree -->
    <project name="xiaomi-chenfeng/android_device_xiaomi_chenfeng-kernel"
					 remote="gitlb"
					 revision="lineage-23.2"
					 path="device/xiaomi/chenfeng-kernel" />

    <!-- hardware tree -->
	<project name="xiaomi-chenfeng/android_hardware_xiaomi-chenfeng"
					 remote="gitlb"
					 revision="lineage-23.2"
					 path="hardware/xiaomi" />

	<!-- proprietary section below -->
    <!-- vendor blobs -->
	<project name="xiaomi-chenfeng/vendor_xiaomi_chenfeng"
					 remote="gitlb"
					 revision="lineage-23.2"
					 path="vendor/xiaomi/chenfeng" />

	<!-- miuicamera blobs -->
	<project name="xiaomi-chenfeng/vendor_xiaomi_chenfeng-miuicamera"
					 remote="gitlb"
					 revision="lineage-23.2"
					 path="vendor/xiaomi/chenfeng-miuicamera" />

	<!-- dolby atmos -->
	<project name="xiaomi-chenfeng/hardware_dolby"
					 remote="gitlb"
					 revision="16"
					 path="hardware/dolby" />

	<!-- GMS blobs: Rising sixteen-qpr2 pins vendor_gms to a dead Forgejo
	     host (v15.next.forgejo.org 404). Override with Evolution-X bka
	     (Baklava/Android 16) mirror — same branch Rising's own sixteen
	     branch family tracks, provides vendor/gms/gms_pico.mk -->
	<remove-project name="vendor_gms" />
	<project name="Evolution-X/vendor_gms"
					 remote="gh"
					 revision="bka"
					 path="vendor/gms"
					 clone-depth="1" />

	<!-- Rising sixteen-qpr2 manifest pairs Lineage apps with Rising's
	     frameworks/base, but Rising dropped Lineage custom framework APIs
	     (DevicePolicyManager/DeviceAdminInfo additions, SupervisionManager
	     methods, DisplayManager extern-display consts, Settings provider
	     keys, UiModeManager force-invert, CallLog PREFERRED_DISPLAY_NAME,
	     etc.). Rising ships its own self-consistent forks of the big
	     consumers on branch qpr2 — use them instead of Lineage's -->
	<remove-project name="LineageOS/android_packages_apps_Settings" />
	<project name="RisingOS-Revived/android_packages_apps_Settings"
					 remote="gh"
					 revision="qpr2"
					 path="packages/apps/Settings"
					 clone-depth="1" />
	<remove-project name="LineageOS/android_packages_apps_Launcher3" />
	<project name="RisingOS-Revived/android_packages_apps_Launcher3"
					 remote="gh"
					 revision="qpr2"
					 path="packages/apps/Launcher3"
					 clone-depth="1" />
	<remove-project name="LineageOS/android_frameworks_libs_systemui" />
	<project name="RisingOS-Revived/android_frameworks_libs_systemui"
					 remote="gh"
					 revision="qpr2"
					 path="frameworks/libs/systemui"
					 clone-depth="1" />
	<remove-project name="LineageOS/android_packages_services_Telecomm" />
	<project name="RisingOS-Revived/android_packages_services_Telecomm"
					 remote="gh"
					 revision="qpr2"
					 path="packages/services/Telecomm"
					 clone-depth="1" />
</manifest>
