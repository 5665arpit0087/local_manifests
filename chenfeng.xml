<?xml version="1.0" encoding="UTF-8"?>
<manifest>
	<remote name="gh" fetch="https://github.com" />
	<remote name="gitlb" fetch="https://gitlab.com" />
	<remote name="gh-kanup4m" fetch="https://github.com/kanup4m" />

    <!-- device tree (RisingOS 16 QPR2, Beyonder) -->
    <project name="android_device_xiaomi_chenfeng"
					 remote="gh-kanup4m"
					 revision="rising-16-qpr2"
					 path="device/xiaomi/chenfeng" />

	<!-- miuicamera tree -->
    <project name="xiaomi-chenfeng/android_device_xiaomi_chenfeng-miuicamera"
					 remote="gitlb"
					 revision="lineage-23.2"
					 path="device/xiaomi/chenfeng-miuicamera" />

    <!-- kernel tree -->
    <project name="xiaomi-chenfeng/android_device_xiaomi_chenfeng-kernel"
					 remote="gitlb"
					 revision="lineage-23.2"
					 path="device/xiaomi/chenfeng-kernel" />

    <!-- hardware tree -->
	<project name="xiaomi-chenfeng/android_hardware_xiaomi-chenfeng"
					 remote="gitlb"
					 revision="lineage-23.2"
					 path="hardware/xiaomi" />

	<!-- proprietary section below -->
    <!-- vendor blobs -->
	<project name="xiaomi-chenfeng/vendor_xiaomi_chenfeng"
					 remote="gitlb"
					 revision="lineage-23.2"
					 path="vendor/xiaomi/chenfeng" />

	<!-- miuicamera blobs -->
	<project name="xiaomi-chenfeng/vendor_xiaomi_chenfeng-miuicamera"
					 remote="gitlb"
					 revision="lineage-23.2"
					 path="vendor/xiaomi/chenfeng-miuicamera" />

	<!-- dolby atmos -->
	<project name="xiaomi-chenfeng/hardware_dolby"
					 remote="gitlb"
					 revision="16"
					 path="hardware/dolby" />

	<!-- GMS blobs: Rising sixteen-qpr2 pins vendor_gms to a dead Forgejo
	     host (v15.next.forgejo.org 404). Override with Evolution-X bka
	     (Baklava/Android 16) mirror — same branch Rising's own sixteen
	     branch family tracks, provides vendor/gms/gms_pico.mk -->
	<remove-project name="vendor_gms" />
	<project name="Evolution-X/vendor_gms"
					 remote="gh"
					 revision="bka"
					 path="vendor/gms"
					 clone-depth="1" />

</manifest>
